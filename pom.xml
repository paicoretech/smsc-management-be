<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
						https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.paicbd.smsc</groupId>
    <artifactId>smsc-management-be</artifactId>
    <version>3.2.0-SNAPSHOT</version>
    <name>smsc-management-be</name>
    <description>SMSc management backend api</description>
    <licenses>
        <license>
            <name>GNU Affero General Public License</name>
            <url>http://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Melvin Mendoza</name>
            <email>melvin.mendoza@paicbd.com</email>
            <organization>PAiC BD</organization>
            <organizationUrl>https://paic-bd.com/</organizationUrl>
            <timezone>-6</timezone>
        </developer>
        <developer>
            <name>Obed Navarrete</name>
            <email>obed.navarrete@paicbd.com</email>
            <organization>PAiC BD</organization>
            <organizationUrl>https://paicbd.com</organizationUrl>
            <timezone>-6</timezone>
        </developer>
        <developer>
            <name>Enmanuel Calero</name>
            <email>enmanuel.calero@paicbd.com</email>
            <organization>PAiC BD</organization>
            <organizationUrl>https://paic-bd.com/</organizationUrl>
            <timezone>-6</timezone>
        </developer>
    </developers>
    <properties>
        <java.version>21</java.version>
        <smsc-utils.version>3.1.0-87</smsc-utils.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <jwt.version>0.11.5</jwt.version>
        <!-- Plugin versions -->
        <junit.jupiter.version>5.10.3</junit.jupiter.version>
        <powermock.version>2.0.9</powermock.version>
        <codehaus.version>2.17.1</codehaus.version>
        <surfire.plugin.version>3.3.1</surfire.plugin.version>
        <sonar.scanner.version>4.0.0.4121</sonar.scanner.version>
        <jacoco.version>0.8.12</jacoco.version>
        <testcontainers.version>1.20.1</testcontainers.version>
        <webflux.version>3.3.2</webflux.version>
        <opencsv.version>5.9</opencsv.version>
        <junit-vintage.version>5.10.3</junit-vintage.version>
        <jsmpp.version>3.1.5</jsmpp.version>
        <mockito.version>5.12.0</mockito.version>
        <apache.poi.version>5.4.0</apache.poi.version>
        <apache.commons.compress.version>1.26.0</apache.commons.compress.version>
        <streaming-reader.version>5.0.0</streaming-reader.version>
        <poi-shered-string.version>2.9.1</poi-shered-string.version>
        <postgresql.version>42.7.3</postgresql.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.quartz-scheduler/quartz-jobs -->
        <dependency>
            <groupId>org.quartz-scheduler</groupId>
            <artifactId>quartz-jobs</artifactId>
            <version>2.5.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context-support</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <version>${webflux.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jwt.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>com.paicbd</groupId>
            <artifactId>smsc-utils</artifactId>
            <version>${smsc-utils.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.powermock</groupId>
            <artifactId>powermock-module-junit4</artifactId>
            <version>${powermock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.junit.vintage/junit-vintage-engine -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit-vintage.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.powermock</groupId>
            <artifactId>powermock-api-mockito2</artifactId>
            <version>${powermock.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.c4-soft.springaddons</groupId>
            <artifactId>spring-addons-oauth2-test</artifactId>
            <version>6.0.12</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>cassandra</artifactId>
            <version>1.20.5</version>
            <scope>test</scope>
        </dependency>

        <!-- https://mvnrepository.com/artifact/com.opencsv/opencsv -->
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>${opencsv.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jsmpp</groupId>
            <artifactId>jsmpp</artifactId>
            <version>${jsmpp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${apache.poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>${apache.commons.compress.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.pjfanning</groupId>
            <artifactId>excel-streaming-reader</artifactId>
            <version>${streaming-reader.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.pjfanning</groupId>
            <artifactId>poi-shared-strings</artifactId>
            <version>${poi-shered-string.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <version>1.21.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${codehaus.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>set</goal>
                            <goal>commit</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surfire.plugin.version}</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <!--
                        Temporarily disabled: heavy integration tests that extend BaseIntegrationTest.
                        Each one boots Testcontainers (PostgreSQL + Redis cluster of 3 nodes + Kafka)
                        and a full Spring Boot context. The static initializer in BaseIntegrationTest
                        runs on class load, so @Disabled cannot prevent execution — exclude here instead.
                        Remove this <excludes> block to re-enable.
                    -->
                    <excludes>
                        <exclude>**/integration/BaseIntegrationTest.java</exclude>
                        <exclude>**/analyze/cdrs/controller/CdrsControllerTest.java</exclude>
                        <exclude>**/analyze/dashboards/controller/DashboardsControllerTest.java</exclude>
                        <exclude>**/broadcast/controller/BroadcastControllerTest.java</exclude>
                        <exclude>**/broadcast/controller/BroadcastFileControllerTest.java</exclude>
                        <exclude>**/broadcast/registry/FutureRegistryTest.java</exclude>
                        <exclude>**/catalog/controller/GetCatalogControllerTest.java</exclude>
                        <exclude>**/credit/controller/CreditBalanceControllerTest.java</exclude>
                        <exclude>**/diameter/controller/DiameterManagerControllerTest.java</exclude>
                        <exclude>**/dnd/controller/DndControllerTest.java</exclude>
                        <exclude>**/dnd/processor/CsvDndFileProcessorTest.java</exclude>
                        <exclude>**/dnd/service/DndServiceTest.java</exclude>
                        <exclude>**/errorcode/controller/DeliveryErrorCodeServiceTest.java</exclude>
                        <exclude>**/errorcode/controller/ErrorCodeControllerTest.java</exclude>
                        <exclude>**/errorcode/controller/ErrorCodeMappingControllerTest.java</exclude>
                        <exclude>**/gateway/controller/GatewaysControllerTest.java</exclude>
                        <exclude>**/interpreter/controller/InterpreterControllerTest.java</exclude>
                        <exclude>**/mno/controller/OperatorMnoControllerTest.java</exclude>
                        <exclude>**/provider/controller/ServiceProviderControllerTest.java</exclude>
                        <exclude>**/report/controller/ReportFileControllerTest.java</exclude>
                        <exclude>**/routing/controller/RoutingRuleControllerTest.java</exclude>
                        <exclude>**/server/controller/SmppServerControllerTest.java</exclude>
                        <exclude>**/settings/controller/CommonVariableControllerTest.java</exclude>
                        <exclude>**/settings/controller/GeneralSettingsControllerTest.java</exclude>
                        <exclude>**/settings/controller/HandlerStatusControllerTest.java</exclude>
                        <exclude>**/sip/controller/SipGatewaysControllerTest.java</exclude>
                        <exclude>**/sip/service/ObjectSipServiceTest.java</exclude>
                        <exclude>**/sip/service/SipUssiAssignmentValidatorTest.java</exclude>
                        <exclude>**/sip/service/UssiAssociationSyncServiceTest.java</exclude>
                        <exclude>**/ss7/controller/Ss7GatewaysControllerHrTest.java</exclude>
                        <exclude>**/ss7/controller/Ss7GatewaysControllerM3uaTest.java</exclude>
                        <exclude>**/ss7/controller/Ss7GatewaysControllerSccpLongMessageRulesTest.java</exclude>
                        <exclude>**/ss7/controller/Ss7GatewaysControllerSccpTest.java</exclude>
                        <exclude>**/ss7/controller/Ss7GatewaysControllerTcapAndMapTest.java</exclude>
                        <exclude>**/ss7/controller/Ss7GatewaysControllerTest.java</exclude>
                        <exclude>**/ss7/service/ObjectSs7ServiceTest.java</exclude>
                        <exclude>**/ss7/service/SccpServiceTest.java</exclude>
                        <exclude>**/user/controller/AuthControllerTest.java</exclude>
                        <exclude>**/user/controller/UserControllerTest.java</exclude>
                        <exclude>**/config/BeansDefinitionTest.java</exclude>
                        <exclude>**/security/ApplicationConfigTest.java</exclude>
                        <exclude>**/security/SecurityConfigTest.java</exclude>
                        <exclude>**/utils/AppPropertiesTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.scanner.version}</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/mapper/**</exclude>
                        <exclude>**/entity/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
